<Project>
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <SonarQubeSetting Include="sonar.coverage.exclusions">
      <Value>**/*.sql</Value>
      <Value>**/*.json</Value>
      <Value>**/Program.cs</Value>
    </SonarQubeSetting>
  </ItemGroup>
</Project>
