<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>Queries</title>
    <style>
{{ include "Styles.sbn" }}
    </style>
</head>
<body class="narrow">
    <h1>Queries</h1>
    <div class="tabs" data-tabs>
        <div class="tab-list" role="tablist" aria-label="Query categories">
            <button class="tab" id="definition-queries-tab" type="button" role="tab"
                    aria-selected="true" aria-controls="definition-queries-panel" tabindex="0">
                Read-only queries
            </button>
            <button class="tab" id="update-queries-tab" type="button" role="tab"
                    aria-selected="false" aria-controls="update-queries-panel" tabindex="-1">
                Update queries
            </button>
        </div>

        <section id="definition-queries-panel" role="tabpanel"
                 aria-labelledby="definition-queries-tab">
            <ul class="query-list">
                {{ for definition in definitions }}
                <li>
                    <a href="/api/query/{{ definition.id | html.url_encode | html.escape }}">{{ definition.display_name | html.escape }}</a>
                    <p class="muted">{{ definition.description | html.escape }}</p>
                </li>
                {{ end }}
            </ul>
        </section>

        <section id="update-queries-panel" role="tabpanel" aria-labelledby="update-queries-tab" hidden>
            <ul class="query-list">
                <li>
                    <a href="/api/resend-invite-email">Re-send Invitation Email</a>
                    <p class="muted">Send the invitation email again using GOV.UK Notify.</p>
                </li>
                <li>
                    <a href="/api/user-details-change">User Details Change Requests</a>
                    <p class="muted">Get regulator identifiers and the latest user details change history identifier.</p>
                </li>
            </ul>
        </section>
    </div>
    <script>
        (() => {
            const tabs = Array.from(document.querySelectorAll('[role="tab"]'));

            function selectTab(selectedTab) {
                tabs.forEach((tab) => {
                    const isSelected = tab === selectedTab;
                    tab.setAttribute('aria-selected', isSelected.toString());
                    tab.tabIndex = isSelected ? 0 : -1;
                    document.getElementById(tab.getAttribute('aria-controls')).hidden = !isSelected;
                });

                selectedTab.focus();
            }

            tabs.forEach((tab, index) => {
                tab.addEventListener('click', () => selectTab(tab));
                tab.addEventListener('keydown', (event) => {
                    let nextIndex;

                    if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
                    if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
                    if (event.key === 'Home') nextIndex = 0;
                    if (event.key === 'End') nextIndex = tabs.length - 1;

                    if (nextIndex !== undefined) {
                        event.preventDefault();
                        selectTab(tabs[nextIndex]);
                    }
                });
            });
        })();
    </script>
</body>
</html>
